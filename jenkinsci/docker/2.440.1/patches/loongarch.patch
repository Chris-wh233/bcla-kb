--- a/17/alpine/hotspot/Dockerfile
+++ b/17/alpine/hotspot/Dockerfile
@@ -1,17 +1 @@
-ARG ALPINE_TAG=3.19.1
-ARG JAVA_VERSION=17.0.10_7
-FROM eclipse-temurin:"${JAVA_VERSION}"-jdk-alpine AS jre-build
-
-# Generate smaller java runtime without unneeded files
-# for now we include the full module path to maintain compatibility
-# while still saving space (approx 200mb from the full distribution)
-# Arguments to jlink are specific to Java 17 jlink
-RUN jlink \
-        --add-modules ALL-MODULE-PATH \
-        --strip-java-debug-attributes \
-        --no-man-pages \
-        --no-header-files \
-        --compress=2 \
-        --output /javaruntime
-
-FROM alpine:"${ALPINE_TAG}" AS build
+FROM alpine:latest AS build
@@ -28 +12,3 @@
-    openssh-client \
+    openjdk17-loongarch-jre-headless \
+    openjdk17-loongarch-jre \
+    openssh-client-default \
@@ -30 +16 @@
-    ttf-dejavu \
+    font-dejavu \
@@ -77,7 +63,3 @@
-# Can be used to customize where jenkins.war get downloaded from
-ARG JENKINS_URL=https://repo.jenkins-ci.org/public/org/jenkins-ci/main/jenkins-war/${JENKINS_VERSION}/jenkins-war-${JENKINS_VERSION}.war
-
-# could use ADD but this one does not check Last-Modified header neither does it allow to control checksum
-# see https://github.com/docker/docker/issues/8331
-RUN curl -fsSL ${JENKINS_URL} -o /usr/share/jenkins/jenkins.war \
-  && echo "${JENKINS_SHA}  /usr/share/jenkins/jenkins.war" >/tmp/jenkins_sha \
+# The official Jenkins WAR was verified before entering the build context.
+COPY artifacts/jenkins-2.440.1.war /usr/share/jenkins/jenkins.war
+RUN echo "${JENKINS_SHA}  /usr/share/jenkins/jenkins.war" >/tmp/jenkins_sha \
@@ -93,2 +75,2 @@
-ARG PLUGIN_CLI_URL=https://github.com/jenkinsci/plugin-installation-manager-tool/releases/download/${PLUGIN_CLI_VERSION}/jenkins-plugin-manager-${PLUGIN_CLI_VERSION}.jar
-RUN curl -fsSL ${PLUGIN_CLI_URL} -o /opt/jenkins-plugin-manager.jar
+COPY artifacts/jenkins-plugin-manager-2.12.15.jar /opt/jenkins-plugin-manager.jar
+RUN echo "2689ad36cf8eed09c6ce496dfc787dbbec7347b1503275e2b1315b65a7fe8e5a  /opt/jenkins-plugin-manager.jar" | sha256sum -c
@@ -104 +86 @@
-ENV JAVA_HOME=/opt/java/openjdk
+ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk
